# Dependency directories
node_modules/

# Build output
dist/
build/
public/build/
database/build

# Logs
*.log
npm-debug.log*

# Environment variables
.env
.env.*.local
.env.local

# TypeScript cache
*.tsbuildinfo

# Testing
test-results/
playwright-report/
# What `yarn test:smoke` writes, at the root because `YarnBuilder.smokeTest()` archives
# `smoke-output/**` relative to the repo root and not to the workspace that produced it.
smoke-output/
coverage/
.nyc_output/
lcov.info
.playwright-mcp/
# Playwright's saved sign-in state. A live session cookie, so a credential — never committable.
.auth/

# Turborepo
.turbo/

# Yarn. Patches are committed: `package.json` resolves pdfjs-dist through one.
.yarn/*
!.yarn/patches/

# macOS
.DS_Store

# intellij
.idea/

# agentic env vars
.mcp.env
.claude/claude.env
.claude/analytics
.claude/settings.local.json

# Helm
**/Chart.lock
**/charts/*.tgz
values.preview.yaml

# Prisma generated client
libs/postgres-prisma/generated/

# NestJS prototype, staged here while its code is migrated into apps/ and libs/.
# Ignored so its node_modules (~500M), dist, .env and data/documents blobs cannot
# be committed by accident. Remove this entry once the migration is complete and
# the directory is deleted.
power_app_nest/

# Uploaded document blobs. file-storage.ts writes to DATA_DIR, defaulting to <cwd>/data, and the
# running app decides the cwd — apps/api/data when the API serves the upload route, apps/web/data
# once the Phase 4 form does. Hence a glob rather than one path. These are real case documents, so
# they must never be committable; no tracked path has a data/ component, so this catches nothing else.
data/

# Terraform. Nothing here was ignored before, and a local `terraform init` leaves 316M of downloaded
# providers in infrastructure/.terraform — the same accident power_app_nest/ is guarded against above.
# State never lives on disk: the backend is azurerm, configured by -backend-config in CI.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# The provider lock file is deliberately not committed, because there has never been one and CI does a
# fresh `terraform init` on every run. Worth revisiting: without it, `~> 4.57` resolves to whatever
# azurerm 4.x is newest at plan time, so a provider release can change a deploy with no change from us.
# Committing one means generating it for every platform CI and developers use
# (`terraform providers lock -platform=linux_amd64 -platform=linux_arm64 -platform=darwin_arm64`),
# otherwise init fails on a missing checksum for the platform it is running on.
**/.terraform.lock.hcl
# Broadened after `steves_notes.md` slipped past the exact-name entry above: a personal note under a
# slightly different name is untracked-but-not-ignored again, which is the one state `git add -A` commits
# by accident.
steve*.md
# And the same argument for a note whose name does not start with "steve": the agent rules-of-engagement file
# is per-engineer, not per-repo. `deed-poll-api` already names it `rules-of-engagement.local.md` for this
# reason, so the suffix is the convention worth sharing across the four repos.
*.local.md

# HMCTS brand assets — logos, colour and typography guides, the letterhead and the icon pack.
#
# Ignored rather than committed because `.business_context/` is NOT ignored (57 files in it are tracked), so
# these would land in the repo permanently: 11 MB against a 33 MB repo, including a 7 MB .pptx, none of it
# diffable and none of it read by any build. The canonical copies belong in SharePoint.
#
# They are **not** needed for Notify: email branding is a service-level setting and HMCTS is one of Notify's
# pre-approved government brands, so it is requested rather than uploaded — see
# .business_context/NOTIFY_PROVISIONING_REQUEST.md. Where they WILL be needed is notify-4's generated
# documents, which this service produces itself and Notify never sees. At that point commit only the specific
# assets the generator consumes, rather than un-ignoring the folder.
.business_context/branding/
