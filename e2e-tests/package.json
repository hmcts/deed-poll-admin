{
  "name": "e2e-tests",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:smoke": "PLAYWRIGHT_JUNIT_OUTPUT_NAME=../smoke-output/smoke-result.xml playwright test --grep @smoke --project chromium --no-deps --reporter=list,junit --output=../smoke-output/test-results",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "playwright:install": "npx playwright install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
