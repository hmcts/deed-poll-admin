{% extends "layouts/default.njk" %}

{#
  Distinct from 404 on purpose. "You cannot access this" and "there is nothing here" are different
  facts, and conflating them makes a permissions problem look like a broken link — which sends the
  caseworker to the wrong person for help.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">You cannot access this page</h1>

    {% if reason %}
      <p class="govuk-body">{{ reason }}</p>
    {% endif %}

    <p class="govuk-body">
      You may need to <a class="govuk-link" href="/login">sign in</a> again, or ask for the right
      permissions if you have already signed in.
    </p>
  </div>
</div>
{% endblock %}
