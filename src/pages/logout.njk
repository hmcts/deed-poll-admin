{% extends "layouts/app.njk" %}

{#
  `GET /logout` signs nobody out: it asks for the click, and only the form's POST ends the session.
#}
{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">{{ title }}</h1>

    <p class="govuk-body">{{ body }}</p>

    <form method="post" action="/logout" novalidate>
      <button type="submit" class="govuk-button" data-module="govuk-button">{{ signOut }}</button>
    </form>
  </div>
</div>
{% endblock %}
