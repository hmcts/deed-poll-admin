{% extends "layouts/app.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}

{% macro lastChangedLine(section) %}
  {% if section.updatedAt %}<p class="govuk-body">{{ lastChanged }} {{ section.updatedAt }}{% if section.updatedBy %} {{ by }} {{ section.updatedBy }}{% endif %}</p>{% endif %}
{% endmacro %}

{% macro numberInput(name, label, hint, suffix) %}
  {{ govukInput({
    id: name, name: name, inputmode: "numeric", spellcheck: false, classes: "govuk-input--width-3",
    label: { text: label, classes: "govuk-label--s" }, hint: { text: hint }, value: process.values[name],
    suffix: { text: suffix } if suffix,
    errorMessage: { text: process.errors[name] } if process.errors[name]
  }) }}
{% endmacro %}

{% macro timeInput(name, label) %}
  {{ govukInput({
    id: name, name: name, spellcheck: false, autocomplete: "off", classes: "govuk-input--width-5",
    label: { text: label }, value: process.values[name],
    errorMessage: { text: process.errors[name] } if process.errors[name]
  }) }}
{% endmacro %}

{% macro windowFieldset(window, legend) %}
  {% call govukFieldset({ legend: { text: legend, classes: "govuk-fieldset__legend--s" }, describedBy: window + "-window-hint", attributes: { id: window + "-window" } }) %}
    <div id="{{ window }}-window-hint" class="govuk-hint">{{ windowHint }}</div>
    {{ timeInput(window + "WindowStart", windowStartLabel) }}
    {{ timeInput(window + "WindowEnd", windowEndLabel) }}
  {% endcall %}
{% endmacro %}

{#
  A tab panel keeps the page's reading width; only the tab list spans the row, as on the case page.
#}
{% macro panelColumn() %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ caller() }}
    </div>
  </div>
{% endmacro %}

{% block page_content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    {% call panelColumn() %}
    {% if errorList.length %}
      {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: errorList }) }}
    {% endif %}
    {% set savedTexts = {
      "process-settings": processSaved,
      "gazette-recipient": gazetteSaved,
      "master-added": masterAdded,
      "master-changed": masterChanged,
      "bank-holiday-added": bankHolidayAdded,
      "bank-holiday-removed": bankHolidayRemoved
    } %}
    {% if savedSection and savedTexts[savedSection] %}
      {{ govukNotificationBanner({ type: "success", titleText: successTitle, text: savedTexts[savedSection] }) }}
    {% endif %}
    <h1 class="govuk-heading-xl">{{ heading }}</h1>
    <p class="govuk-body">{{ intro }}</p>
    {% endcall %}

    {% set processPanel %}{% call panelColumn() %}
      <h2 class="govuk-heading-m">{{ processHeading }}</h2>
      {% if process.isAvailable %}
        <p class="govuk-body">{{ processIntro }}</p>
        <form method="post" action="/deed-polls/settings#process-settings" novalidate>
          <input type="hidden" name="revision" value="{{ process.values.revision }}">
          {{ numberInput("processingDays", processingDaysLabel, processingDaysHint, daysSuffix) }}
          {{ numberInput("reminderIntervalHours", reminderIntervalLabel, reminderIntervalHint, hoursSuffix) }}
          {{ numberInput("windowCap", windowCapLabel, windowCapHint) }}
          {{ windowFieldset("morning", morningWindowLegend) }}
          {{ windowFieldset("afternoon", afternoonWindowLegend) }}
          {% if process.isNeverChanged %}<p class="govuk-body">{{ processNeverChanged }}</p>{% endif %}
          {{ lastChangedLine(process) }}
          {% if not process.reloadText %}
            {{ govukWarningText({ text: processWarning, iconFallbackText: warningIcon }) }}
            {{ govukButton({ text: processSave }) }}
          {% endif %}
        </form>
        {% if process.reloadText %}
          {# The form posts to /deed-polls/settings#process-settings, so a link differing only by its fragment would scroll, not reload. #}
          <p class="govuk-body"><a id="reload-process-settings" class="govuk-link" href="/deed-polls/settings?reload=process-settings#process-settings">{{ processReloadLink }}</a></p>
        {% endif %}
      {% else %}
        <p class="govuk-body">{{ processUnavailable }}</p>
      {% endif %}
    {% endcall %}{% endset %}
    {% if gazette %}
      {% set gazettePanel %}{% call panelColumn() %}
        <h2 class="govuk-heading-m">{{ gazetteHeading }}</h2>
        {% if gazette.isAvailable %}
          <p class="govuk-body">{{ gazetteIntro }}</p>
          {% if gazette.isUnset %}<p class="govuk-inset-text">{{ gazetteNotSet }}</p>{% endif %}
          {{ lastChangedLine(gazette) }}
          <form method="post" action="/deed-polls/settings/gazette-recipient#gazette-recipient" novalidate>
            <input type="hidden" name="revision" value="{{ gazette.values.revision }}">
            {{ govukInput({
              id: "recipientEmail", name: "recipientEmail", type: "email", autocomplete: "email", spellcheck: false,
              label: { text: gazetteEmailLabel }, hint: { text: gazetteHint }, value: gazette.values.recipientEmail,
              errorMessage: { text: gazette.emailError } if gazette.emailError
            }) }}
            {% if not gazette.reloadText %}{{ govukButton({ text: gazetteSave }) }}{% endif %}
          </form>
          {% if gazette.reloadText %}
            <p class="govuk-body"><a id="reload-gazette-recipient" class="govuk-link" href="/deed-polls/settings#gazette-recipient">{{ gazetteReloadLink }}</a></p>
          {% endif %}
        {% else %}
          <p class="govuk-body">{{ gazetteUnavailable }}</p>
        {% endif %}
        <p class="govuk-body"><a class="govuk-link" href="/deed-polls/gazette">{{ gazetteBack }}</a></p>
      {% endcall %}{% endset %}
    {% endif %}
    {% set mastersPanel %}{% call panelColumn() %}
      <h2 class="govuk-heading-m">{{ mastersHeading }}</h2>
      <p class="govuk-body">{{ mastersIntro }}</p>
      {% if masters.isAvailable %}
        {% if masters.rows.length %}
          {% set masterRows = [] %}
          {% for row in masters.rows %}
            {% set masterRows = (masterRows.push([
              { text: row.name },
              { text: row.email },
              { text: yes if row.isAvailable else no },
              { text: yes if row.isLinked else no },
              { html: '<a class="govuk-link" href="' + (row.changePath | escape) + '">' + (change | escape) + '<span class="govuk-visually-hidden"> ' + (row.name | escape) + '</span></a>' }
            ]), masterRows) %}
          {% endfor %}
          {{ govukTable({
            caption: mastersCaption, captionClasses: "govuk-visually-hidden",
            head: [{ text: masterNameColumn }, { text: masterEmailColumn }, { text: masterAvailableColumn }, { text: masterLinkedColumn }, { html: '<span class="govuk-visually-hidden">' + (change | escape) + '</span>' }],
            rows: masterRows
          }) }}
        {% else %}
          <p class="govuk-body">{{ mastersEmpty }}</p>
        {% endif %}
      {% else %}
        <p class="govuk-body">{{ mastersUnavailable }}</p>
      {% endif %}
      <h3 class="govuk-heading-s">{{ addMasterHeading }}</h3>
      <p class="govuk-body">{{ addMasterHint }}</p>
      <form method="post" action="/deed-polls/settings/masters#masters" novalidate>
        {{ govukInput({
          id: "master-name", name: "name", autocomplete: "off", spellcheck: false,
          label: { text: masterNameLabel }, value: masterAdd.values.name,
          errorMessage: { text: masterAdd.errors.name } if masterAdd.errors.name
        }) }}
        {{ govukInput({
          id: "master-email", name: "email", type: "email", autocomplete: "off", spellcheck: false,
          label: { text: masterEmailLabel }, value: masterAdd.values.email,
          errorMessage: { text: masterAdd.errors.email } if masterAdd.errors.email
        }) }}
        {% if masterAdd.refusedText %}<p class="govuk-error-message">{{ masterAdd.refusedText }}</p>{% endif %}
        {{ govukButton({ text: addMasterSave, classes: "govuk-button--secondary" }) }}
      </form>
    {% endcall %}{% endset %}
    {% set bankHolidaysPanel %}{% call panelColumn() %}
      <h2 class="govuk-heading-m">{{ bankHolidaysHeading }}</h2>
      <p class="govuk-body">{{ bankHolidaysIntro }}</p>
      {% if bankHolidays.isAvailable %}
        {% if bankHolidays.rows.length %}
          {% set holidayRows = [] %}
          {% for row in bankHolidays.rows %}
            {% set holidayRows = (holidayRows.push([
              { text: row.date },
              { text: row.name },
              { html: '<a class="govuk-link" href="' + (row.removePath | escape) + '">' + (remove | escape) + '<span class="govuk-visually-hidden"> ' + (row.name | escape) + ' ' + (row.date | escape) + '</span></a>' }
            ]), holidayRows) %}
          {% endfor %}
          {{ govukTable({
            caption: bankHolidaysCaption, captionClasses: "govuk-visually-hidden",
            head: [{ text: bankHolidayDateColumn }, { text: bankHolidayNameColumn }, { html: '<span class="govuk-visually-hidden">' + (remove | escape) + '</span>' }],
            rows: holidayRows
          }) }}
        {% else %}
          <p class="govuk-body">{{ bankHolidaysEmpty }}</p>
        {% endif %}
      {% else %}
        <p class="govuk-body">{{ bankHolidaysUnavailable }}</p>
      {% endif %}
      <h3 class="govuk-heading-s">{{ addBankHolidayHeading }}</h3>
      <form method="post" action="/deed-polls/settings/bank-holidays#bank-holidays" novalidate>
        {{ govukDateInput({
          id: "bank-holiday-date", namePrefix: "date",
          fieldset: { legend: { text: bankHolidayDateLegend } },
          hint: { text: bankHolidayDateHint },
          errorMessage: { text: holidayAdd.errors.date } if holidayAdd.errors.date,
          items: [
            { name: "day", label: day, classes: "govuk-input--width-2" + (" govuk-input--error" if holidayAdd.errors.date else ""), value: holidayAdd.values.day },
            { name: "month", label: month, classes: "govuk-input--width-2" + (" govuk-input--error" if holidayAdd.errors.date else ""), value: holidayAdd.values.month },
            { name: "year", label: year, classes: "govuk-input--width-4" + (" govuk-input--error" if holidayAdd.errors.date else ""), value: holidayAdd.values.year }
          ]
        }) }}
        {{ govukInput({
          id: "bank-holiday-name", name: "name", autocomplete: "off",
          label: { text: bankHolidayNameLabel }, hint: { text: bankHolidayNameHint }, value: holidayAdd.values.name,
          errorMessage: { text: holidayAdd.errors.name } if holidayAdd.errors.name
        }) }}
        {% if holidayAdd.refusedText %}<p class="govuk-error-message">{{ holidayAdd.refusedText }}</p>{% endif %}
        {{ govukButton({ text: addBankHolidaySave, classes: "govuk-button--secondary" }) }}
      </form>
    {% endcall %}{% endset %}
    {% set staffPanel %}{% call panelColumn() %}
      <h2 class="govuk-heading-m">{{ staffHeading }}</h2>
      <p class="govuk-body">{{ staffIntro }}</p>
      <p class="govuk-body"><a class="govuk-link" href="{{ xuiStaffAdminUrl }}" target="_blank" rel="noopener noreferrer">{{ staffLink }}</a></p>
    {% endcall %}{% endset %}

    {#
      Each panel's id is its section's old fragment, so every `?saved=…#section` redirect, the Gazette pages' settings
      links and the Change and Remove pages' back links still open the right tab. A form's action carries the same
      fragment, so a refused save, which renders at the POST address, opens on the tab whose error it shows.
    #}
    {% set tabItems = [{ label: processHeading, id: "process-settings", panel: { html: processPanel } }] %}
    {% if gazette %}
      {% set tabItems = (tabItems.push({ label: gazetteHeading, id: "gazette-recipient", panel: { html: gazettePanel } }), tabItems) %}
    {% endif %}
    {% set tabItems = (tabItems.push(
      { label: mastersHeading, id: "masters", panel: { html: mastersPanel } },
      { label: bankHolidaysHeading, id: "bank-holidays", panel: { html: bankHolidaysPanel } },
      { label: staffHeading, id: "staff-and-access", panel: { html: staffPanel } }
    ), tabItems) %}
    {{ govukTabs({ items: tabItems, classes: "app-case-tabs" }) }}
  </div>
</div>
{% endblock %}
