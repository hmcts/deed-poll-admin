{% extends "layouts/app-full-width.njk" %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "deed-polls/two-column-card.njk" import twoColumnCard %}

{#
  One column of a two-column card: the section's rows as a borderless summary list. Borderless
  because the card already supplies the enclosing border, and a row rule running only half the
  card's width reads as a broken table.
#}
{% macro columnList(rows) %}
  {% if rows.length %}
    {% set items = [] %}
    {% for r in rows %}
      {% set items = (items.push({ key: { text: r.key }, value: { text: r.value } }), items) %}
    {% endfor %}
    {{ govukSummaryList({ rows: items, classes: "govuk-summary-list--no-border govuk-!-margin-bottom-0" }) }}
  {% endif %}
{% endmacro %}

{#
  Tabs, sections and rows all come from the `tabs` view model, derived from the same FORM_TABS
  metadata as the edit forms (see detail-view.ts). Do not hand-list fields here: that is exactly how
  this page fell six tabs behind the form in the prototype. A new field belongs in form-fields.ts and
  then appears on both pages.
#}
{% block content %}

  {% if presentation.privacy.showBanner %}
    {{ govukNotificationBanner({ titleText: bannerTitle, text: presentation.privacy.bannerText, type: "important" }) }}
  {% endif %}

  {#
    Where a completed send lands. The journey redirects here rather than rendering a confirmation page of its own,
    so the outcome is a banner above the case — and a redundant send is one of the two successes it reports, never
    a failure (see emails/[template]/send.ts). The link appears only when the handler could match the id to a row
    this case has, because it comes from a query parameter.
  #}
  {% if emailBanner %}
    {% set emailBannerHtml %}
      <p class="govuk-notification-banner__heading">
        {{ emailBanner.text }}
        {% if emailBanner.href %}<a class="govuk-notification-banner__link" href="{{ emailBanner.href }}">{{ viewSentEmail }}</a>{% endif %}
      </p>
    {% endset %}
    {{ govukNotificationBanner({ titleText: successTitle, html: emailBannerHtml, type: "success" }) }}
  {% endif %}

  {#
    Case header, porting the Dynamics form header above the tabs. Rows come from the `header` view
    model (case-header.ts) — do not hand-list them. State renders as a tag so status stays
    scannable; every other row is plain text.
  #}
  <span class="govuk-caption-l">{{ header.entityLabel }}</span>
  <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">
    {{ pageHeading }}
    {% if case.privacy == "Private" %}{{ govukTag({ text: privateTag, classes: "govuk-tag--red" }) }}{% endif %}
  </h1>

  {% set headerRows = [] %}
  {% for row in header.rows %}
    {% if row.tag %}
      {% set valueCell = { html: govukTag({ text: row.value }) } %}
    {% else %}
      {% set valueCell = { text: row.value } %}
    {% endif %}
    {% set headerRows = (headerRows.push({ key: { text: row.key }, value: valueCell }), headerRows) %}
  {% endfor %}
  {{ govukSummaryList({ rows: headerRows }) }}

  {% set tabItems = [] %}
  {% for tab in tabs %}

    {% set panelHtml %}
      {#
        Notes grid. Rows come from the `notes` view model (notes-view.ts), already sorted and
        formatted. The code shown is derived from the note's id, not the source's autonumber, which
        is not ported.

        Created and Modified are two columns rather than one "Added by" cell, each leading with its
        timestamp and carrying the person beneath as hint text: the dates are what a caseworker scans
        a note history for, so they get the column position, while the author answers a follow-up
        question. A note never edited says "Not edited" rather than repeating the creation pair — the
        distinction only means something once the two differ, and a dash would not say whether the
        data is missing or the event never happened.
      #}
      {% if tab.subgrid == "notes" %}
        {% if notes.count %}
          <p class="govuk-caption-m">{{ notes.count }} note{{ "" if notes.count == 1 else "s" }}</p>
          {% set noteRows = [] %}
          {% for n in notes.rows %}
            {% set createdCell %}
              {{ n.createdOn }}<br>
              <span class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">{{ n.createdBy }}</span>
            {% endset %}
            {% set modifiedCell %}
              {% if n.unmodified %}
                <span class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">{{ notEdited }}</span>
              {% else %}
                {{ n.modifiedOn }}<br>
                <span class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">{{ n.modifiedBy }}</span>
              {% endif %}
            {% endset %}
            {#
              The code is the link into the amend page, as it is the row's handle. The href carries
              the full uuid, never the code: the code is display only and not unique enough to
              resolve a note. The hidden suffix keeps the link text meaningful out of context.
            #}
            {% set codeCell %}
              <a class="govuk-link app-nowrap" href="/deed-polls/{{ case.id }}/notes/{{ n.id }}/edit">{{ n.code }}<span class="govuk-visually-hidden"> — {{ amendNoteHint }}</span></a>
            {% endset %}
            {% set noteRows = (noteRows.push([
              { html: codeCell },
              { text: n.note },
              { html: createdCell },
              { html: modifiedCell }
            ]), noteRows) %}
          {% endfor %}
          {{ govukTable({
            head: [
              { text: noteColumns[0] },
              { text: noteColumns[1] },
              { text: noteColumns[2] },
              { text: noteColumns[3] }
            ],
            rows: noteRows
          }) }}
        {% else %}
          <p class="govuk-body">{{ noneRecorded }}</p>
        {% endif %}
        {# Outside the count check: a case with no notes is exactly when you need this. #}
        {{ govukButton({ text: addNote, href: "/deed-polls/" + case.id + "/notes/new", classes: "govuk-button--secondary" }) }}

      {#
        Witnesses grid. Unlike notes and documents these come off the case itself — one call to api
        already carries them — so there is no view model, and `w` is the wire record.
      #}
      {% elif tab.subgrid == "witnesses" %}
        {#
          How many are recorded against how many a case needs, stated whether the requirement is met or
          not: a caseworker checking a complete case should see that it is complete, and a count that
          only appeared when something was wrong would read as an error rather than a status. Outside the
          count check for the same reason the Add button is — a case with none is what needs saying most.

          The whole sentence comes from the view model, so the threshold is api's constant and never a
          literal here — see witnesses/enrolment-requirement.ts.
        #}
        <p class="govuk-caption-m">{{ witnessCount }}</p>
        {% if case.witnesses.length %}
          {% for w in case.witnesses %}
            {#
              The name is the row's handle, so it carries the link into the amend page, the same shape as
              a note's code cell above: the href holds the uuid, and a hidden suffix keeps the link text
              meaningful out of context. A nameless witness falls back to the placeholder rather than
              rendering an anchor with nothing in it to click.
            #}
            <h3 class="govuk-heading-s">
              <a class="govuk-link" href="/deed-polls/{{ case.id }}/witnesses/{{ w.id }}/edit">{{ w.witnessName or unnamedWitness }}<span class="govuk-visually-hidden"> — {{ amendWitnessHint }}</span></a>
              {% if w.declarant %}{{ govukTag({ text: declarantTag, classes: "govuk-tag--blue" }) }}{% endif %}
            </h3>
            {#
              Declarant is a row as well as the tag. The tag only appears when true, so its absence cannot
              say whether the answer is no or whether anyone recorded one — and `declarant` is a non-null
              boolean on the wire, so there is always one of the two to state.
            #}
            {{ govukSummaryList({ rows: [
              { key: { text: witnessAddress }, value: { text: w.witnessAddress } },
              { key: { text: witnessOccupation }, value: { text: w.witnessOccupation } },
              { key: { text: witnessDeclarant }, value: { text: yes if w.declarant else no } }
            ] }) }}
          {% endfor %}
        {% else %}
          <p class="govuk-body">{{ noneRecorded }}</p>
        {% endif %}
        {# Outside the count check, as the notes button is: a case with no witnesses is when you need it. #}
        {{ govukButton({ text: addWitness, href: "/deed-polls/" + case.id + "/witnesses/new", classes: "govuk-button--secondary" }) }}

      {% elif tab.subgrid == "documents" %}
        {% if documents.length %}
          {% set docRows = [] %}
          {% for d in documents %}
            {#
              Links to this app's own download route, not deed-poll-api's. The prototype could use
              /api/... because one Nest app served both; api is a separate service on a separate
              origin, so a direct link would need its base URL on the page and would leave the
              browser's session behind. The route forwards api's stream instead, same-origin and
              with the caseworker's token. A document with no file attached is not linked.
            #}
            {% set nameCell %}
              {% if d.downloadable %}
                <a class="govuk-link" href="/deed-polls/{{ case.id }}/documents/{{ d.id }}/file">{{ d.name }}</a>
              {% else %}
                {{ d.name }}
              {% endif %}
            {% endset %}
            {% set docRows = (docRows.push([
              { html: nameCell },
              { text: d.type },
              { text: d.direction },
              { text: d.added }
            ]), docRows) %}
          {% endfor %}
          {{ govukTable({
            head: [
              { text: documentColumns[0] },
              { text: documentColumns[1] },
              { text: documentColumns[2] },
              { text: documentColumns[3] }
            ],
            rows: docRows
          }) }}
        {% else %}
          <p class="govuk-body">{{ noneRecorded }}</p>
        {% endif %}
        {{ govukButton({ text: uploadDocument, href: "/deed-polls/" + case.id + "/documents/upload", classes: "govuk-button--secondary" }) }}

      {#
        Referrals to the judiciary. The only subgrid whose rows are not on the case payload — they come from a
        second api call — so `referrals` is a view model (referrals-view.ts) rather than `case.referrals`, and
        every cell here is already a display string.

        The whole history, newest first as api ordered it, because a case can be referred more than once and
        the closed ones are how a caseworker sees what the judiciary has already been asked. The date raised is
        the row's handle and carries the link, the same shape as a note's code cell above.
      #}
      {% elif tab.subgrid == "referrals" %}
        {#
          Three states, not two. `unavailable` is the read having failed, which is a different claim from a
          case that has never been referred — rendering it as "None recorded." would tell a caseworker the
          case is free of the judiciary when the page does not know. See referrals-view.ts.
        #}
        {% if referrals.unavailable %}
          {{ govukWarningText({ text: referralsUnavailable, iconFallbackText: warningIcon }) }}
        {% elif referrals.count %}
          <p class="govuk-caption-m">{{ referrals.count }} referral{{ "" if referrals.count == 1 else "s" }}</p>
          {% set referralRows = [] %}
          {% for r in referrals.rows %}
            {% set raisedCell %}
              <a class="govuk-link app-nowrap" href="/deed-polls/{{ case.id }}/referrals/{{ r.id }}">{{ r.createdOn }}<span class="govuk-visually-hidden"> — {{ viewReferralHint }}</span></a><br>
              <span class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">{{ r.createdBy }}</span>
            {% endset %}
            {#
              A migrated referral has no reasons and says so, rather than showing a blank cell that reads as
              missing data: the power app it came from recorded none.
            #}
            {% set reasonsCell %}
              {% if r.reasons.length %}
                <ul class="govuk-list govuk-!-margin-bottom-0">
                  {% for reason in r.reasons %}<li>{{ reason }}</li>{% endfor %}
                </ul>
              {% elif r.migrated %}
                <span class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">{{ migratedReferral }}</span>
              {% else %}
                {{ noneRecorded }}
              {% endif %}
            {% endset %}
            {% set referralRows = (referralRows.push([
              { html: raisedCell },
              { html: govukTag({ text: r.state, classes: r.stateTagClasses }) },
              { html: reasonsCell },
              { text: r.urgency }
            ]), referralRows) %}
          {% endfor %}
          {{ govukTable({
            head: [
              { text: referralColumns[0] },
              { text: referralColumns[1] },
              { text: referralColumns[2] },
              { text: referralColumns[3] }
            ],
            rows: referralRows
          }) }}
        {% else %}
          <p class="govuk-body">{{ noneRecorded }}</p>
        {% endif %}
        {#
          Unlike the Add buttons above, this one is conditional: a case holds one live referral at a time and
          api answers 409 for a second, so offering the form while one is open would only fail after it was
          filled in. api still enforces the transition, which is why raising is a 409 rather than an
          impossibility.

          `offerRaise` and not `not referrals.liveReferral`, because there are two reasons to withhold it and
          only one of them has a message here: a live referral says so, an unavailable read has already said so
          in the warning above. referrals-view.ts owns which, so this template cannot get the order of two
          booleans wrong and offer the form on a panel that knows nothing.

          The message is looked up by the live referral's state rather than being one sentence: telling a
          caseworker with a returned direction in front of them to withdraw it would be asking them to undo the
          work they are being asked to do — and api refuses that withdrawal anyway.
        #}
        {% if referrals.offerRaise %}
          {{ govukButton({ text: raiseReferral, href: "/deed-polls/" + case.id + "/referrals/new", classes: "govuk-button--secondary" }) }}
        {% elif referrals.liveReferral %}
          <p class="govuk-body">{{ liveReferralMessages[referrals.liveReferral.message] }}</p>
        {% endif %}

        {#
          The previous system's referral record, kept readable now its editable tab has gone (see
          legacy-referral-view.ts). Only the fields the case actually holds, so a case with none of them shows
          no section at all rather than a column of "Not provided" against ten retired fields.

          **Outside every branch above**, and that is the point of putting it last: it comes off the case, not
          off the referrals call, so a failed read degrades the live history and leaves the historical record
          where it is. Nesting it in the `else` would hide a migrated case's whole referral history behind an
          api the page had already given up on.

          Its own heading, below the live list, because the two are different records and a caseworker must not
          read a 2024 Master's direction as this case's current position.
        #}
        {% if legacyReferral %}
          <h2 class="govuk-heading-m govuk-!-margin-top-6">{{ legacyReferralHeading }}</h2>
          <p class="govuk-body">{{ legacyReferralIntro }}</p>
          {% set legacyRows = [] %}
          {% for row in legacyReferral.rows %}
            {% set legacyRows = (legacyRows.push({ key: { text: row.key }, value: { text: row.value } }), legacyRows) %}
          {% endfor %}
          {{ govukSummaryList({ rows: legacyRows }) }}
        {% endif %}

      {#
        Correspondence with the applicant: what has been sent, and what may be sent now. The second subgrid
        whose rows are not on the case payload, so `emails` is a view model (emails-view.ts) and every cell here
        is already a display string.

        The table is metadata only. An email's subject and body are several paragraphs and would destroy the
        table's scannability, so the template name is the row's handle and links to the per-email page — the
        same shape as a note's code cell above. Decision 14 of docs/plans/notify-2-caseworker-email-tab.md.

        Nothing in this panel may read as proof of receipt. api knows that GOV.UK Notify accepted the send and
        nothing more — there are no delivery callbacks in this estate and no download concept at all — so the
        state column's words come from the domain's own label map and the hint spells out what they mean.
        Decision 10, and detail.njk.test.ts asserts no "Delivered", "Viewed", "Opened" or "Downloaded" survives
        in this panel.
      #}
      {% elif tab.subgrid == "emails" %}
        {#
          Three states, as the referrals panel has: `unavailable` is the read having failed, which is a
          different claim from an applicant who has never been written to. "None recorded." would say the
          second on a panel that knows neither.
        #}
        {% if emails.unavailable %}
          {{ govukWarningText({ text: emailsUnavailable, iconFallbackText: warningIcon }) }}
        {% elif emails.count %}
          <p class="govuk-caption-m">{{ emails.count }} email{{ "" if emails.count == 1 else "s" }}</p>
          {% set emailRows = [] %}
          {% for e in emails.rows %}
            {% set emailNameCell %}
              <a class="govuk-link" href="/deed-polls/{{ case.id }}/emails/{{ e.id }}">{{ e.template }}<span class="govuk-visually-hidden"> — {{ viewEmailHint }}</span></a>
            {% endset %}
            {% set emailCreatedCell %}
              {{ e.sentOn }}<br>
              <span class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-0">{{ e.sentBy }}</span>
            {% endset %}
            {% set emailRows = (emailRows.push([
              { html: emailNameCell },
              { html: emailCreatedCell },
              { html: govukTag({ text: e.state, classes: e.stateTagClasses }) }
            ]), emailRows) %}
          {% endfor %}
          {{ govukTable({
            head: [
              { text: emailColumns[0] },
              { text: emailColumns[1] },
              { text: emailColumns[2] }
            ],
            rows: emailRows
          }) }}
          <p class="govuk-hint">{{ emailsStateHint }}</p>
        {% else %}
          <p class="govuk-body">{{ noneRecorded }}</p>
        {% endif %}
        {#
          One button per template api says may be sent now, rather than a picker in front of a list of one:
          api ships a single template today, and radios with one option read as an unfinished feature. The loop
          is what makes a template added by notify-3 or notify-6 appear here with no code change — and more than
          one reaching it is the trigger to build the picker decision 2 deferred.

          The name comes from the view model, and the template key out of the same place, so a button can only
          ever point at a compose page the same payload says is sendable.
        #}
        {% for s in emails.sendable %}
          {{ govukButton({
            text: sendEmail + ": " + s.name,
            href: "/deed-polls/" + case.id + "/emails/" + s.template + "/compose",
            classes: "govuk-button--secondary"
          }) }}
        {% endfor %}
        {#
          And the reason for every button that is not there. An applicant with no email address and a case no
          Master has refused are both common, and a panel with nothing on it reads as a bug — so api's own
          sentence is rendered beside the template it is about. emails-view.ts guarantees every template lands
          in exactly one of the two lists.
        #}
        {% for u in emails.unsendable %}
          <p class="govuk-body">{{ u.name }}: {{ u.reason }}</p>
        {% endfor %}

      {% else %}
        {% if tab.empty %}
          <p class="govuk-body">{{ noneRecorded }}</p>
        {% else %}
          {#
            Each section is a govuk-summary-card whose body holds a sequence of bands, replicating
            the Dynamics form's cards. A `columns` band is two half-width summary lists; a `full`
            band is one across the whole card, porting the source's colspan="2" cells (Return Reason,
            Referral Notes, Master Directions). Positions come from the view model's `blocks` — see
            card-layout.ts. Rows align within a column, not across the two, so a long wrapped value
            cannot drag its neighbour out of line.

            Do not flatten this back to a fixed left/right pair: full-width fields are interleaved
            with two-column ones, so a card is a sequence of bands, not one split. The empty half of
            a one-sided band is deliberate — the source leaves that cell empty and the blank keeps
            every other field where staff expect it.
          #}
          {% for section in tab.sections %}
            {% call twoColumnCard(section.label, { href: "/deed-polls/" + case.id + "/edit/" + tab.id, text: changeLink }) %}
              {% for block in section.blocks %}
                {% if block.kind == "full" %}
                  <div class="govuk-grid-column-full app-card-column app-card-column--full">
                    {{ columnList(block.rows) }}
                  </div>
                {% else %}
                  <div class="govuk-grid-column-one-half app-card-column">
                    {{ columnList(block.left) }}
                  </div>
                  <div class="govuk-grid-column-one-half app-card-column">
                    {{ columnList(block.right) }}
                  </div>
                {% endif %}
              {% endfor %}
            {% endcall %}
          {% endfor %}
        {% endif %}
      {% endif %}
    {% endset %}

    {% set tabItems = (tabItems.push({ label: tab.label, id: tab.id, panel: { html: panelHtml } }), tabItems) %}
  {% endfor %}

  {{ govukTabs({ items: tabItems }) }}

  <p class="govuk-body"><a class="govuk-link" href="/deed-polls">{{ backToCases }}</a></p>
{% endblock %}
