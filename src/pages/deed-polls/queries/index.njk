{% extends "layouts/app.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{#
  The library. A list because it is one, and not a table: every row carries a form and a conditional link,
  which a table macro can only take as pre-built HTML — and building markup in a handler is how a page stops
  being reviewable.

  Add and Remove are the same control in two states rather than two controls, so there is never a button
  offering what the row already is. Amend renders only when api says `editable`, and is absent rather than
  disabled when it does not — `witness-edit.njk` holds the reasoning.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">{{ heading }}</h1>
    <p class="govuk-body">{{ intro }}</p>
    <p class="govuk-hint">{{ sharedNote }}</p>

    {% if rows.length %}
      <ul class="govuk-list">
        {% for row in rows %}
          <li class="govuk-!-margin-bottom-7">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">
              <a class="govuk-link govuk-link--no-visited-state" href="{{ row.href }}">{{ row.name }}</a>
            </h2>

            {% if row.shared %}{{ govukTag({ text: sharedTag, classes: "govuk-tag--blue" }) }}{% endif %}
            {% if row.selected %}{{ govukTag({ text: selectedTag, classes: "govuk-tag--green" }) }}{% endif %}

            {% if row.description %}
              <p class="govuk-body govuk-!-margin-top-2">{{ row.description }}</p>
            {% endif %}

            <p class="govuk-body-s govuk-!-margin-bottom-2">{{ ownerLabel }}: {{ row.ownerName }}</p>

            <form method="post" action="{{ libraryPath }}" novalidate>
              <input type="hidden" name="queryId" value="{{ row.id }}">
              <div class="govuk-button-group">
                {% if row.selected %}
                  {{ govukButton({ text: remove, name: "action", value: "remove", classes: "govuk-button--secondary" }) }}
                {% else %}
                  {{ govukButton({ text: add, name: "action", value: "add", classes: "govuk-button--secondary" }) }}
                {% endif %}
                {% if row.editable %}
                  <a class="govuk-link" href="{{ libraryPath }}/{{ row.id }}/edit">{{ amend }}</a>
                {% endif %}
              </div>
            </form>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="govuk-body">{{ empty }}</p>
    {% endif %}

    <p class="govuk-body">
      <a class="govuk-link" href="{{ backHref }}">{{ backToList }}</a>
    </p>

  </div>
</div>
{% endblock %}
