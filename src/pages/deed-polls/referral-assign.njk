{% extends "layouts/app.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{#
  Assign a referral to a Master, or to another one (plan Db1). One question, the raise form's radios, with the current
  Master pre-selected. Who has it now and that a new Master's time starts again are said above the question, as inset
  text, because they are about what the choice will do rather than part of it.

  Without a list there is no question and no submit, for the raise form's reason: nothing could be sent.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errorList.length %}
      {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: errorList }) }}
    {% endif %}

    <span class="govuk-caption-l">{{ case.displayReference }}</span>
    <h1 class="govuk-heading-xl">{{ heading }}</h1>

    {% if currentlyWith %}
      <p class="govuk-body">{{ currentlyWith }}</p>
    {% endif %}
    {% if restartsWindow %}
      {{ govukInsetText({ text: restartsWindow }) }}
    {% endif %}

    <form method="post" action="{{ action }}" novalidate>
      {% if isMastersUnavailable %}
        <p class="govuk-body" id="masterId">{{ mastersUnavailable }}</p>
      {% elif hasNoMasters %}
        <p class="govuk-body" id="masterId">{{ noMasters }}</p>
      {% else %}
        {{ govukRadios({
          idPrefix: "masterId",
          name: "masterId",
          fieldset: { legend: { text: masterLegend, classes: "govuk-fieldset__legend--m" } },
          items: masterItems,
          errorMessage: { text: errors.masterId } if errors.masterId
        }) }}
      {% endif %}

      <div class="govuk-button-group">
        {% if not isMastersUnavailable and not hasNoMasters %}
          {{ govukButton({ text: submit }) }}
        {% endif %}
        <a class="govuk-link" href="{{ referralHref }}">{{ cancel }}</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
