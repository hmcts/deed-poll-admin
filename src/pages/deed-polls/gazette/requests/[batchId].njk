{% extends "layouts/app-full-width.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% block content %}
  <p class="govuk-body"><a class="govuk-link" href="/deed-polls/gazette/requests">{{ back }}</a></p>
  <h1 class="govuk-heading-xl">{{ heading }}</h1>
  {% if isUnavailable %}
    <p class="govuk-body">{{ unavailable }}</p>
  {% else %}
    <p class="govuk-body">{{ explanation }}</p>
    {{ govukSummaryList({ rows: rows }) }}
    {% if hasMissingDetails %}<p class="govuk-body">{{ legacy }}</p>{% endif %}
    <h2 class="govuk-heading-m">{{ membersHeading }}</h2>
    <p class="govuk-body">{{ frozen }}</p>
    {% if members == null %}
      <p class="govuk-body">{{ membersUnavailable }}</p>
    {% elif members.cases.length == 0 %}
      <p class="govuk-body">{{ emptyPage if isBeyondEnd else empty }}</p>
      {% if isBeyondEnd %}<p class="govuk-body"><a class="govuk-link" href="{{ path }}">{{ firstPage }}</a></p>{% endif %}
    {% else %}
      {% set memberRows = [] %}
      {% for member in members.cases %}{% set memberRows = (memberRows.push([{ text: member.referenceNumber }]), memberRows) %}{% endfor %}
      {{ govukTable({ head: [{ text: reference }], rows: memberRows, caption: membersHeading, captionClasses: "govuk-visually-hidden" }) }}
    {% endif %}
    {% if pagingSummary %}<p class="govuk-body">{{ pagingSummary }}</p>{% endif %}
    {% if paging.links %}{{ govukPagination({ previous: paging.links.previous, next: paging.links.next, items: paging.links.items, landmarkLabel: pagingLabel }) }}{% endif %}
  {% endif %}
  <p class="govuk-body"><a class="govuk-link" href="">{{ refresh }}</a></p>
  <p class="govuk-body"><a class="govuk-link" href="/deed-polls/gazette/history">{{ history }}</a></p>
{% endblock %}
