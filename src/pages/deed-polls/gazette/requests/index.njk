{% extends "layouts/app-full-width.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% block content %}
  <p class="govuk-body"><a class="govuk-link" href="/deed-polls/gazette">{{ back }}</a></p>
  <h1 class="govuk-heading-xl">{{ heading }}</h1>
  <p class="govuk-body">{{ intro }}</p>
  <p class="govuk-body"><a class="govuk-link" href="/deed-polls/gazette/history">{{ history }}</a></p>
  {% if isUnavailable %}
    <p class="govuk-body">{{ unavailable }}</p>
  {% elif requests.length == 0 %}
    <p class="govuk-body">{{ emptyPage if isBeyondEnd else empty }}</p>
    {% if isBeyondEnd %}<p class="govuk-body"><a class="govuk-link" href="/deed-polls/gazette/requests">{{ firstPage }}</a></p>{% endif %}
  {% else %}
    {% set rows = [] %}
    {% for request in requests %}
      {% set link %}<a class="govuk-link" href="/deed-polls/gazette/requests/{{ request.batchId | pathSegment }}">{{ details }}<span class="govuk-visually-hidden">: {{ request.submittedAt }}</span></a>{% endset %}
      {% set rows = (rows.push([{ text: request.submittedAt }, { text: request.submittedBy }, { text: request.state }, { text: request.caseCount }, { html: link }]), rows) %}
    {% endfor %}
    {{ govukTable({ head: [{ text: submitted }, { text: by }, { text: state }, { text: count }, { text: details }], rows: rows, caption: heading, captionClasses: "govuk-visually-hidden" }) }}
  {% endif %}
  {% if pagingSummary %}<p class="govuk-body">{{ pagingSummary }}</p>{% endif %}
  {% if paging.links %}{{ govukPagination({ previous: paging.links.previous, next: paging.links.next, items: paging.links.items, landmarkLabel: pagingLabel }) }}{% endif %}
  <p class="govuk-body"><a class="govuk-link" href="">{{ refresh }}</a></p>
{% endblock %}
