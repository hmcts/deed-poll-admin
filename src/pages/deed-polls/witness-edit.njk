{% extends "layouts/default.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{#
  Amend-a-witness form. The same four controls as `witness-form.njk`, and that file holds the reasoning
  for each: one textarea for the one address column, radios rather than a checkbox for `declarant`, and no
  maxlength attributes.

  One difference from the note amend form, because a witness is not a note: there is no audit summary list
  above the controls. `deedpoll_witness` has no created/modified columns, so there is nothing to show — the
  page would be stating "unknown" four times.

  Delete is a second submit button on the SAME form rather than its own route, so the two cannot drift; the
  handler branches on `action`, checking delete first. Styled as a warning so it cannot be mistaken for the
  primary action, and no confirmation step — the same call the note delete made, for the same act.

  It is shown only when `canDelete` — hidden rather than disabled, because a button has no value to read and
  a permanently disabled destructive control is noise on every witness a caseworker opens. Amending is open
  to both roles, so only this button is conditional: the form, the four controls and Save are not.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errorList.length %}
      {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: errorList }) }}
    {% endif %}

    <span class="govuk-caption-l">{{ case.displayReference }}</span>
    <h1 class="govuk-heading-xl">{{ heading }}</h1>

    <form method="post" action="/deed-polls/{{ case.id }}/witnesses/{{ witnessId }}/edit" novalidate>
      {{ govukInput({
        id: "witnessName",
        name: "witnessName",
        autocomplete: "off",
        label: { text: nameLabel, classes: "govuk-label--m" },
        value: values.witnessName,
        errorMessage: { text: errors.witnessName } if errors.witnessName
      }) }}

      {{ govukTextarea({
        id: "witnessAddress",
        name: "witnessAddress",
        rows: 4,
        autocomplete: "off",
        label: { text: addressLabel, classes: "govuk-label--m" },
        value: values.witnessAddress,
        errorMessage: { text: errors.witnessAddress } if errors.witnessAddress
      }) }}

      {{ govukInput({
        id: "witnessOccupation",
        name: "witnessOccupation",
        autocomplete: "off",
        label: { text: occupationLabel, classes: "govuk-label--m" },
        value: values.witnessOccupation,
        errorMessage: { text: errors.witnessOccupation } if errors.witnessOccupation
      }) }}

      {{ govukRadios({
        idPrefix: "declarant",
        name: "declarant",
        classes: "govuk-radios--inline",
        fieldset: { legend: { text: declarantLabel, classes: "govuk-fieldset__legend--m" } },
        items: [
          { value: "true", text: yes, checked: values.declarant == "true" },
          { value: "false", text: no, checked: values.declarant == "false" }
        ],
        errorMessage: { text: errors.declarant } if errors.declarant
      }) }}

      <div class="govuk-button-group">
        {{ govukButton({ text: submit, name: "action", value: "save" }) }}
        {% if canDelete %}
          {{ govukButton({ text: delete, name: "action", value: "delete", classes: "govuk-button--warning" }) }}
        {% endif %}
        <a class="govuk-link" href="/deed-polls/{{ case.id }}#witnesses">{{ cancel }}</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
