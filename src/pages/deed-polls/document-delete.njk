{% extends "layouts/app.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{#
  The document deletion confirmation and its two other states (`[id]/documents/[documentId]/delete.ts`):

  - `form`: the document's details and the required reason, then the warning-styled submit. Cancel is a link, so the
    submit, whose action is the literal `delete`, is the only thing that can act. A refusal api gave (the document in
    use, say) is the error summary's first item and names no field.
  - `unknown`: api's answer never came. The one control replays the sealed request (`check`); there is no form to
    change it and no way to start another.
  - `stopped`: a changed document, a reused key, or an expired or forged confirmation. Links only.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if state == "form" %}

      {% if errorList.length %}
        {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: errorList }) }}
      {% endif %}

      {% if reference %}<span class="govuk-caption-l">{{ reference }}</span>{% endif %}
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      {% set items = [] %}
      {% for row in summaryRows %}
        {% set items = (items.push({ key: { text: row.key }, value: { text: row.value } }), items) %}
      {% endfor %}
      {% if items.length %}
        {{ govukSummaryList({ rows: items }) }}
      {% endif %}

      {% if viewHref %}
        <p class="govuk-body"><a class="govuk-link" href="{{ viewHref }}">{{ viewDocument }}</a></p>
      {% endif %}

      <form method="post" action="{{ actionPath }}" novalidate>
        <input type="hidden" name="journey" value="{{ journey }}">

        {{ govukCharacterCount({
          id: "reason",
          name: "reason",
          rows: 4,
          maxlength: reasonMax,
          value: reason,
          label: { text: reasonLabel, classes: "govuk-label--m" },
          hint: { text: reasonHint },
          errorMessage: { text: errors.reason } if errors.reason
        }) }}

        {{ govukWarningText({ text: warning, iconFallbackText: warningIcon }) }}

        <div class="govuk-button-group">
          {{ govukButton({ text: confirm, name: "action", value: "delete", classes: "govuk-button--warning", preventDoubleClick: true }) }}
          <a class="govuk-link" href="{{ documentsPath }}">{{ cancel }}</a>
        </div>
      </form>

    {% elif state == "unknown" %}

      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      <p class="govuk-body">{{ unknown }}</p>
      <form method="post" action="{{ actionPath }}" novalidate>
        <input type="hidden" name="journey" value="{{ journey }}">
        <div class="govuk-button-group">
          {{ govukButton({ text: check, name: "action", value: "check", preventDoubleClick: true }) }}
          <a class="govuk-link" href="{{ documentsPath }}">{{ returnToDocuments }}</a>
        </div>
      </form>

    {% else %}

      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      <p class="govuk-body">{{ sentence }}</p>
      <p class="govuk-body"><a class="govuk-link" href="{{ documentsPath }}">{{ returnToDocuments }}</a></p>

    {% endif %}

  </div>
</div>
{% endblock %}
