{% extends "layouts/app.njk" %}

{% set title = staffAccess.unavailableHeading %}

{#
  Rendered by the IDAM callback when api's `GET /me` could not be asked (OWASP plan 01 Task 6). Not the 403 page,
  because "we could not check" sends the user to try again, and "you have no access" sends them to their manager.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">{{ staffAccess.unavailableHeading }}</h1>

    <p class="govuk-body">{{ staffAccess.unavailableBody }}</p>

    <p class="govuk-body"><a class="govuk-link" href="/login">{{ staffAccess.signInAgain }}</a></p>
  </div>
</div>
{% endblock %}
