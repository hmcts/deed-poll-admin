{% extends "layouts/app.njk" %}

{#
  Rendered by `domainErrorHandler` for a `TooManyRequestsError`: an abuse limit, api's or this app's own. Its own
  page rather than the 500 one, because "wait" and "the service is broken" send the caseworker different ways.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">{{ tooManyRequests.heading }}</h1>

    <p class="govuk-body">{{ tooManyRequests.explanation }}</p>

    <p class="govuk-body">
      {%- if retryAfterMinutes == 1 -%}
        {{ tooManyRequests.tryAgainInOneMinute }}
      {%- elif retryAfterMinutes -%}
        {{ tooManyRequests.tryAgainInMinutes | replace("{minutes}", retryAfterMinutes) }}
      {%- else -%}
        {{ tooManyRequests.tryAgainLater }}
      {%- endif -%}
    </p>
  </div>
</div>
{% endblock %}
