{% extends "layouts/app.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{#
  The shared pool. Four columns, no filter bar and no sortable headers: api fixes the order and the page
  (decision 3), so everything a judge does here is choosing a row.

  No case reference anywhere, because api's pool row carries none — a queue that named the applicants would be
  a list of applications a judge has not been asked to read yet. That is why each row's link is qualified by its
  wait rather than by a reference: "View" alone would be the accessible name of every link on the page.

  The urgency cell prints its word and tags it; the tag's colour reinforces the word and never replaces it.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {#
      A claim api refused, as a message on the page the judge is sent back to. An error summary rather than a
      banner to match the caseworker's refused withdrawal (`deed-polls/referral-detail.njk`) — the same shape
      of event: a write that was refused, redirected back to the page that owns the wording.
    #}
    {% if claimRefused %}
      {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: [{ text: claimRefused }] }) }}
    {% endif %}

    <h1 class="govuk-heading-xl">{{ heading }}</h1>
    <p class="govuk-body">{{ intro }}</p>

    {% if rows.length == 0 %}
      <p class="govuk-body">{{ empty }}</p>
    {% else %}
      {% set tableRows = [] %}
      {% for row in rows %}
        {% set urgencyCell %}
          {% if row.isUrgent %}{{ govukTag({ text: row.urgency, classes: "govuk-tag--red" }) }}{% else %}{{ row.urgency }}{% endif %}
        {% endset %}
        {% set reasonsCell %}
          <ul class="govuk-list govuk-!-margin-bottom-0">
            {% for reason in row.reasons %}<li>{{ reason }}</li>{% endfor %}
          </ul>
        {% endset %}
        {% set actionCell %}
          <a class="govuk-link" href="/judicial/referrals/{{ row.id | urlencode }}">{{ view }}<span class="govuk-visually-hidden"> {{ row.viewHint }}</span></a>
        {% endset %}
        {% set tableRows = (tableRows.push([
          { html: urgencyCell },
          { html: reasonsCell },
          { text: row.waitingSince },
          { html: actionCell }
        ]), tableRows) %}
      {% endfor %}

      {{ govukTable({
        head: [
          { text: urgencyHeading },
          { text: reasonsHeading },
          { text: waitingHeading },
          { text: actionHeading }
        ],
        rows: tableRows,
        caption: heading,
        captionClasses: "govuk-visually-hidden"
      }) }}
    {% endif %}

    {# api's counts, not a count of the rows above: ten is this page's size and the pool may hold a hundred. #}
    {% if pagingSummary %}
      <p class="govuk-body">{{ pagingSummary }}</p>
    {% endif %}

    {% if paging and paging.links %}
      {{ govukPagination({
        previous: paging.links.previous,
        next: paging.links.next,
        items: paging.links.items,
        landmarkLabel: pagingLabel
      }) }}
    {% endif %}
  </div>
</div>
{% endblock %}
