{% extends "layouts/app.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "judicial/referrals/list-navigation.njk" import judicialListNavigation %}

{#
  A judge's own referrals. Five columns, no filter bar and no sortable headers: api decides membership from the
  token's subject and fixes the order (`referrals-admin-6` decisions 1 and 2), so everything a judge does here is
  choosing a row.

  **A status column, where the pool has none.** The pool is `Open` only, so a column of identical tags there
  would be furniture; here the two states are the whole point — what this judge still owes, and what they have
  answered and the court has not yet actioned.

  No case reference and no applicant anywhere, because api's row carries none (decision 3): the summary is the
  pool's, so a name on this page would be a field the DTO does not have and a call per row to get it. That is why
  each row's link is qualified by its date and status rather than by a reference — "View" alone would be the
  accessible name of every link on the page.

  Every tag prints its word and colours it; the colour reinforces the word and never replaces it.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">{{ heading }}</h1>

    {{ judicialListNavigation(nav, navCurrent) }}

    <p class="govuk-body">{{ intro }}</p>

    {% if rows.length == 0 %}
      <p class="govuk-body">{{ empty }}</p>
    {% else %}
      {% set tableRows = [] %}
      {% for row in rows %}
        {% set statusCell %}
          {{ govukTag({ text: row.status, classes: row.statusTagClasses }) }}
        {% endset %}
        {% set urgencyCell %}
          {% if row.isUrgent %}{{ govukTag({ text: row.urgency, classes: "govuk-tag--red" }) }}{% else %}{{ row.urgency }}{% endif %}
        {% endset %}
        {% set reasonsCell %}
          <ul class="govuk-list govuk-!-margin-bottom-0">
            {% for reason in row.reasons %}<li>{{ reason }}</li>{% endfor %}
          </ul>
        {% endset %}
        {% set actionCell %}
          <a class="govuk-link" href="{{ row.id | referralPath }}">{{ view }}<span class="govuk-visually-hidden"> {{ row.viewHint }}</span></a>
        {% endset %}
        {% set tableRows = (tableRows.push([
          { html: statusCell },
          { html: urgencyCell },
          { html: reasonsCell },
          { text: row.raisedOn },
          { html: actionCell }
        ]), tableRows) %}
      {% endfor %}

      {{ govukTable({
        head: [
          { text: statusHeading },
          { text: urgencyHeading },
          { text: reasonsHeading },
          { text: raisedHeading },
          { text: actionHeading }
        ],
        rows: tableRows,
        caption: heading,
        captionClasses: "govuk-visually-hidden"
      }) }}
    {% endif %}

    {# api's counts, not a count of the rows above: ten is this page's size and a judge may hold more. #}
    {% if pagingSummary %}
      <p class="govuk-body">{{ pagingSummary }}</p>
    {% endif %}

    {% if paging and paging.links %}
      {{ govukPagination({
        previous: paging.links.previous,
        next: paging.links.next,
        items: paging.links.items,
        landmarkLabel: pagingLabel
      }) }}
    {% endif %}
  </div>
</div>
{% endblock %}
