{% extends "layouts/app.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{#
  A Master's own referrals in three sections (Steve, 2026-10-28): Urgent, then "Awaiting your direction" and
  "Directed, awaiting the office" under one heading per day referred. The handler groups api's order and resolves
  every sentence; this template only draws what it was given, and draws no section that is empty.

  No case reference and no applicant anywhere, because api's row carries none (decision 3). That is why each row's
  link is qualified by its date and reasons — "View" alone would be the accessible name of every link on the page.

  `referredOn` is printed only in the Urgent section: elsewhere the day is the heading the row sits under. A
  directed row has no due date, so its section has no dates column.
#}
{% macro referralTable(rows, caption, labels, showReferred, showDates) %}
  {% set tableRows = [] %}
  {% for row in rows %}
    {% set reasonsCell %}
      <ul class="govuk-list govuk-!-margin-bottom-0">
        {% for reason in row.reasons %}<li>{{ reason }}</li>{% endfor %}
      </ul>
    {% endset %}
    {% set datesCell %}
      <ul class="govuk-list govuk-!-margin-bottom-0">
        {% if showReferred %}<li>{{ row.referredOnText }}</li>{% endif %}
        {% if row.dueByText %}<li>{{ row.dueByText }}</li>{% endif %}
      </ul>
    {% endset %}
    {% set actionCell %}
      <a class="govuk-link" href="{{ row.id | referralPath }}">{{ labels.view }}<span class="govuk-visually-hidden"> {{ row.viewHint }}</span></a>
    {% endset %}
    {% if showDates %}
      {% set tableRows = (tableRows.push([{ html: reasonsCell }, { html: datesCell }, { html: actionCell }]), tableRows) %}
    {% else %}
      {% set tableRows = (tableRows.push([{ html: reasonsCell }, { html: actionCell }]), tableRows) %}
    {% endif %}
  {% endfor %}
  {% if showDates %}
    {% set head = [{ text: labels.reasonsHeading }, { text: labels.datesHeading }, { text: labels.actionHeading }] %}
  {% else %}
    {% set head = [{ text: labels.reasonsHeading }, { text: labels.actionHeading }] %}
  {% endif %}
  {{ govukTable({ head: head, rows: tableRows, caption: caption, captionClasses: "govuk-visually-hidden" }) }}
{% endmacro %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">{{ heading }}</h1>

    <p class="govuk-body">{{ intro }}</p>

    {% set labels = { view: view, reasonsHeading: reasonsHeading, datesHeading: datesHeading, actionHeading: actionHeading } %}

    {% if isEmpty %}
      <p class="govuk-body">{{ empty }}</p>
    {% else %}
      {% if urgent.length %}
        <h2 class="govuk-heading-l">{{ urgentHeading }}</h2>
        {{ referralTable(urgent, urgentHeading, labels, true, true) }}
      {% endif %}

      {% if awaiting.length %}
        <h2 class="govuk-heading-l">{{ awaitingHeading }}</h2>
        {% for group in awaiting %}
          <h3 class="govuk-heading-m">{{ group.heading }}</h3>
          {{ referralTable(group.rows, group.heading, labels, false, true) }}
        {% endfor %}
      {% endif %}

      {% if directed.length %}
        <h2 class="govuk-heading-l">{{ directedHeading }}</h2>
        {% for group in directed %}
          <h3 class="govuk-heading-m">{{ group.heading }}</h3>
          {{ referralTable(group.rows, group.heading, labels, false, false) }}
        {% endfor %}
      {% endif %}
    {% endif %}

    {# api's counts, not a count of the rows above. #}
    {% if pagingSummary %}
      <p class="govuk-body">{{ pagingSummary }}</p>
    {% endif %}

    {% if paging and paging.links %}
      {{ govukPagination({
        previous: paging.links.previous,
        next: paging.links.next,
        items: paging.links.items,
        landmarkLabel: pagingLabel
      }) }}
    {% endif %}
  </div>
</div>
{% endblock %}
