{% extends "layouts/app.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{#
  One referral and its application — read-only apart from the controls a Master has.

  Three things this template deliberately does not have. No link to the case: api's judicial surface takes no
  case id, so there is nowhere to link to. No "add note" control: a judge's writes are exactly claim and direct.
  And no field that is not on the view model — the application panel is `JudicialApplicationView` and nothing
  else, which is the disclosure boundary made visual.

  The claim control is a form because it changes something; "Record a direction" is a link because it opens a
  page, as are change and withdraw on a decided one. Each appears only in the state it belongs to, and api
  re-checks every one regardless.
#}
{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {#
      What a redirect sent the judge back with. A success banner for a recorded, changed or withdrawn direction — not a correction
      to anything on the page, which is what a banner is for — and an error summary for a write api refused
      because of the state below: a direction on a referral no longer theirs, a claim on one already theirs, or a
      change to a direction they have not given.
      Both refusals are one `refused` key, since a judge arrives through one door or the other and never both.
    #}
    {% if directionBanner %}
      {% set recordedHtml %}<p class="govuk-notification-banner__heading">{{ directionBanner }}</p>{% endset %}
      {{ govukNotificationBanner({ type: "success", titleText: successTitle, html: recordedHtml }) }}
    {% endif %}
    {% if refused %}
      {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: [{ text: refused }] }) }}
    {% endif %}

    <span class="govuk-caption-l">{{ referral.application.reference if referral.application else "" }}</span>
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">{{ heading }}</h1>

    <h2 class="govuk-heading-m">{{ applicationHeading }}</h2>
    {#
      Read-only, and built from the judicial view model alone. The Masters asked for this page's order (Master
      Sullivan's feedback, 2026-10-27): the application's General fields, then the referral, then the supporting
      documents. No witnesses, case notes or previous-system record, and no edit, upload, delete or email control.
    #}
    {% if referral.application %}
      {% for section in referral.application.sections %}
        {% if section.rows.length %}
          {% set sectionRows = [] %}
          {% for row in section.rows %}
            {% set sectionRows = (sectionRows.push({ key: { text: row.key }, value: { text: row.value } }), sectionRows) %}
          {% endfor %}
          <h3 class="govuk-heading-s">{{ section.label }}</h3>
          {{ govukSummaryList({ rows: sectionRows }) }}
        {% endif %}
      {% endfor %}

    {% else %}
      <p class="govuk-body">{{ applicationMissing }}</p>
    {% endif %}

    <h2 class="govuk-heading-m">{{ referralHeading }}</h2>

    {% set reasonsCell %}
      {% if referral.reasons.length %}
        <ul class="govuk-list govuk-!-margin-bottom-0">
          {% for reason in referral.reasons %}<li>{{ reason }}</li>{% endfor %}
        </ul>
      {% else %}
        {{ noneRecorded }}
      {% endif %}
    {% endset %}

    {# The urgency tag reinforces the word it sits beside; the word is always printed. #}
    {% set urgencyCell %}
      {% if referral.isUrgent %}{{ govukTag({ text: referral.urgency, classes: "govuk-tag--red" }) }}{% else %}{{ referral.urgency }}{% endif %}
    {% endset %}

    {% set referralRows = [
      { key: { text: stateLabel }, value: { html: govukTag({ text: referral.state, classes: referral.stateTagClasses }) } },
      { key: { text: reasonsLabel }, value: { html: reasonsCell } },
      { key: { text: notesLabel }, value: { text: referral.notes } },
      { key: { text: urgencyLabel }, value: { html: urgencyCell } },
      { key: { text: urgencyReasonLabel }, value: { text: referral.urgencyReason } }
    ] %}
    {# Only once it is in this judge's hands — api's visibility means a claimed referral is theirs or invisible. #}
    {% if referral.claimedOn %}
      {% set referralRows = (referralRows.push({ key: { text: claimedLabel }, value: { text: referral.claimedOn } }), referralRows) %}
    {% endif %}

    {{ govukSummaryList({ rows: referralRows }) }}

    {% if referral.application %}
      {# `documents` is the viewer's way back (`src/document-viewer/context.ts`), so a Master returns to this list. #}
      <h2 class="govuk-heading-m" id="documents">{{ documentsHeading }}</h2>
      {% if documents.length %}
        {% set documentRows = [] %}
        {% for document in documents %}
          {% set nameCell %}<a class="govuk-link" href="{{ document.href }}">{{ document.name }}</a>{% endset %}
          {% set documentRows = (documentRows.push([
            { html: nameCell },
            { text: document.type },
            { text: document.uploadedOn },
            { text: document.size }
          ]), documentRows) %}
        {% endfor %}
        {{ govukTable({
          head: [{ text: documentNameColumn }, { text: documentTypeColumn }, { text: documentUploadedColumn }, { text: documentSizeColumn }],
          rows: documentRows
        }) }}
      {% else %}
        <p class="govuk-body">{{ documentsEmpty }}</p>
      {% endif %}
    {% endif %}

    {#
      The direction already recorded, which is how a judge re-reads a referral they have decided. Absent until
      api holds one, rather than rendered empty: a decision row saying nothing would read as an undecided
      referral that had been through this page.

      `gazetteAnswer` is resolved by the handler rather than read off the model with a ternary here, and that is
      not only convention: api's `publishToGazette` is nullish and this panel is keyed on `decision`, so it has
      three states. `{{ yes if … else no }}` would print "No" for a direction api recorded no answer for —
      telling the judge they directed against publication, which is the one answer on this screen that cannot be
      taken back.
    #}
    {% if referral.direction %}
      <h2 class="govuk-heading-m">{{ directionHeading }}</h2>
      {{ govukSummaryList({
        rows: [
          { key: { text: decisionLabel }, value: { text: referral.direction.decision } },
          { key: { text: directionsLabel }, value: { text: referral.direction.directionsText } },
          { key: { text: gazetteLabel }, value: { text: gazetteAnswer } },
          { key: { text: decidedLabel }, value: { text: referral.direction.decidedOn } }
        ]
      }) }}
    {% endif %}


    {#
      `preventDoubleClick` because the second of two rapid clicks is what the judge is left looking at: api records
      the first and 409s the second, so a claim that succeeded would render as "not waiting to be claimed". The
      sentence stays true — it is theirs now — but it arrives in an error summary, which reads as a refusal. The
      server side is the guard (api refuses, and the 409 lands on the referral rather than the pool); this only
      stops the judge seeing the refusal in the first place, so the flow is unchanged without JavaScript.
    #}
    {% if referral.claimable %}
      <form method="post" action="{{ claimHref }}" novalidate>
        <p class="govuk-body">{{ claimHint }}</p>
        {{ govukButton({ text: claim, preventDoubleClick: true }) }}
      </form>
    {% elif referral.directable %}
      {{ govukButton({ text: direct, href: directionHref }) }}
    {% elif referral.changeable %}
      <ul class="govuk-list">
        <li><a class="govuk-link" href="{{ changeHref }}">{{ changeDirection }}</a></li>
        <li><a class="govuk-link" href="{{ withdrawHref }}">{{ withdrawDirection }}</a></li>
      </ul>
    {% endif %}

    {#
      Back to whichever list this referral is on — the shared pool while it is `Open`, My referrals once this judge
      holds it or has directed it. Both the destination and the words come resolved from the state api sent, so
      there is no ternary here and no `returnTo` in the URL to trust: see the handler's docblock.
    #}
    <p class="govuk-body">
      <a class="govuk-link" href="{{ backHref }}">{{ backLabel }}</a>
    </p>
  </div>
</div>
{% endblock %}
