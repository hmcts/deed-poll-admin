{% extends "layouts/app.njk" %}

{% block page_content %}
  <h1 class="govuk-heading-xl">{{ title }}</h1>

  <ul class="govuk-list">
    <li>
      <h2 class="govuk-heading-m">{{ sections.sendMessage.heading }}</h2>
      <p class="govuk-body">{{ sections.sendMessage.description }}</p>
      <p class="govuk-body">
        <a href="{{ support.url }}" class="govuk-link">{{ sections.sendMessage.linkText }}</a>
      </p>
    </li>

    <li>
      <h2 class="govuk-heading-m">{{ sections.telephone.heading }}</h2>
      <p class="govuk-body">{{ sections.telephone.description }}</p>
      <p class="govuk-body">
        <a href="{{ support.phoneUrl }}" class="govuk-link">{{ support.phone }}</a>
      </p>
    </li>

    <li>
      <h2 class="govuk-heading-m">{{ sections.openingHours.heading }}</h2>
      <p class="govuk-body">{{ sections.openingHours.hours }}</p>
    </li>
  </ul>
{% endblock %}
