{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@hmcts/crons": [
        "./apps/crons/src"
      ],
      "@hmcts/web": [
        "./apps/web/src"
      ],
      "@hmcts-cft/express-govuk-starter": [
        "./libs/express-govuk-starter/src"
      ],
      "@hmcts-cft/express-session-postgres": [
        "./libs/express-session-postgres/src"
      ],
      "@hmcts-cft/express-session-redis": [
        "./libs/express-session-redis/src"
      ],
      "@hmcts-cft/cloud-native-platform": [
        "./libs/cloud-native-platform/src"
      ],
      "@hmcts-cft/simple-router": [
        "./libs/simple-router/src"
      ],
      "@hmcts/deed-poll": [
        "./libs/deed-poll/src"
      ],
      "@hmcts/deed-poll-api-client": [
        "./libs/deed-poll-api-client/src"
      ]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  }
}
