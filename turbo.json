{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "**/.env.*", "charts/**", "**/Dockerfile"],
  // **Turbo filters the environment, and an undeclared variable simply does not reach the task.** That is not a
  // caching nicety: it silently changes behaviour. `DEED_POLL_API_URL=… yarn dev` did nothing for an hour on
  // 2026-09-23 — the app fell back to its in-memory mock, which accepted a send and delivered no email, so the
  // UI reported success while the real api's database held zero rows. A missing entry here looks like an
  // application bug, so add one whenever code starts reading a new variable.
  //
  // **passThroughEnv, not env, and the distinction is the point.** These are per-environment *runtime* values
  // read through `process.env` at request time; none of them changes what a build produces. Listing them under
  // `env` would make every one part of the cache key, so pointing a local run at a different api would
  // needlessly invalidate the build — and it would put `SESSION_SECRET` into Turbo's cache metadata, which is
  // somewhere a secret has no business being. `passThroughEnv` passes the value and hashes nothing.
  //
  // Not listed, deliberately: `NODE_ENV`, which every script that needs it sets inline rather than inheriting
  // (`dev:app` and `start` both do), and `MY_SECRET`, which only exists inside
  // `properties-volume/properties.test.ts` and is set by the test itself rather than supplied to it.
  "globalPassThroughEnv": [
    "APPLICATIONINSIGHTS_ROLE_NAME",
    "AZURE_INJECTED",
    "DEED_POLL_API_MOCK_PORT",
    "DEED_POLL_API_MOCK_SCENARIO",
    "DEED_POLL_API_TIMEOUT_MS",
    "DEED_POLL_API_URL",
    "NO_INJECT_SECRET",
    "PORT",
    "REDIS_URL",
    "SESSION_SECRET",
    "VITE_MIDDLEWARE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "inputs": ["**/*.ts", "**/*.njk", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "config/**", "package.json"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "inputs": ["package.json", "**/*.ts"],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // The application is the root package since plan 03 task 3 flattened `apps/web` into it, and turbo only
    // runs a root-package script when the task is named `//#<task>`. The `:app` suffix is not decoration: a
    // root task called `//#build` would make `yarn build` — which is `turbo build` — invoke itself, so the
    // orchestrating script and the task it schedules must have different names. Each `yarn <x>` therefore
    // runs `turbo <x> <x>:app`, and the libraries still build before the app because of `^build`.
    "//#build:app": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "config/**", "vite.build.ts", "tsconfig.json", "tsconfig.app.json", "package.json"]
    },
    "//#test:app": {
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "config/**", "vitest.config.ts", "tsconfig.json", "tsconfig.app.json", "package.json"],
      "cache": false
    },
    "//#dev:app": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "config/**", "package.json"]
    }
  }
}
