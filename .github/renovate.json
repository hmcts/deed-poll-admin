{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>hmcts/.github:renovate-config", "config:recommended"],
  "automerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Node.js version in .nvmrc",
      "managerFilePatterns": ["/^\\.nvmrc$/"],
      "matchStrings": ["(?<currentValue>.*?)\\n"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Update Node.js version in Dockerfiles. The optional prefix matches registry-qualified base images such as hmctsprod.azurecr.io/base/node",
      "managerFilePatterns": ["/(^|/)Dockerfile[^/]*$/"],
      "matchStrings": [
        "FROM\\s+(?:[^\\s/]+(?:/[^\\s/]+)*/)?node:(?<currentValue>[0-9]+(?:\\.[0-9]+)?(?:\\.[0-9]+)?)-(?:alpine|slim|bullseye|bookworm)(?:\\s|$)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "docker",
      "packageNameTemplate": "node",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Update Node.js version in GitHub Actions",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["node-version:\\s*['\"]?(?<currentValue>[0-9]+(?:\\.[0-9]+)?(?:\\.[0-9]+)?)['\"]?"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      "description": "Never automerge a major. Breaking changes need a human to read the changelog",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep @types/node on the runtime major in .nvmrc. Types ahead of the runtime describe APIs that are not there. Raise this bound when Node's major changes",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Hold the Welsh extractor's TypeScript alias on 6.x. TypeScript 7 dropped the JavaScript compiler API that scripts/extract-welsh-strings.mjs parses with; the build's own typescript moves freely",
      "matchDepNames": ["typescript-6"],
      "allowedVersions": "<7"
    },
    {
      "description": "Group all Node.js version updates",
      "groupName": "Node.js version",
      "matchPackageNames": ["node"],
      "matchManagers": ["custom.regex", "nvm"],
      "matchDatasources": ["node-version", "docker"],
      "enabled": true
    },
    {
      "description": "Auto-merge Node.js minor and patch updates",
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Require approval for Node.js major updates. Redundant with the global major rule, but stated last so it also governs a grouped branch that mixes update types",
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "constraints": {
    "node": ">=22"
  }
}
